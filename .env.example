
# Formulaire de contact (/api/contact) — sans ces variables la route répond 503 et le site propose le mail direct
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
CONTACT_TO=contact@no-code-hub.fr

# Mesure d'audience Google Analytics 4 — facultatif.
# Sans cette variable, AUCUN script Google n'est chargé : un oubli de
# configuration ne peut pas faire fuiter de données.
# Avec elle, le script n'est chargé qu'après acceptation de la catégorie
# « analytics » dans la bannière de cookies (src/components/GoogleAnalytics.tsx).
# Identifiant de flux GA4, de la forme G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
